<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Blaster Scene</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.claudeblast.scene</string>
			</array>
		</dict>
	</array>
	<!--
	  Export compliance: Blaster uses only standard HTTPS/TLS (URLSession to
	  api.openai.com) and Apple-provided cryptography (Keychain, PBKDF2 via
	  CryptoKit for the admin PIN, CloudKit transport). That is exempt under
	  the App Store's encryption rules. Declaring it here stops App Store
	  Connect from prompting for export compliance on every single upload.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Blaster Scene</string>
			<key>UTTypeIconFiles</key>
			<array/>
			<key>UTTypeIdentifier</key>
			<string>com.claudeblast.scene</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>blasterscene</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.claudeblast.scene+json</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
