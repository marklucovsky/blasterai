# macOS
.DS_Store

# Xcode
DerivedData/
*.xcuserstate
xcuserdata/
*.moved-aside
*.xcscmblueprint
# Xcode user-specific files / schemes that often contain secrets
*.xccheckout
xcshareddata/WorkspaceSettings.xcsettings
xcshareddata/IDEWorkspaceChecks.plist

# The development scheme is where OPENAI_API_KEY is set (CLAUDE.md, "Override:
# set OPENAI_API_KEY env var in scheme"), so it carries a live key in plain XML
# and must never be committed.
#
# `xcshareddata/` used to be ignored wholesale for that reason, which was safe
# and also meant **no** scheme was in git — so `xcodebuild -scheme` worked only
# via Xcode's autocreate-schemes behaviour, on the machine that had run Xcode.
# A release anyone else can reproduce needs a shared scheme, so the rule is now
# per-scheme rather than per-directory: the retail scheme has no environment
# variables and is tracked; this one never is.
claudeBlast.xcodeproj/xcshareddata/xcschemes/claudeBlast.xcscheme

# Claude Code working directories, inside the repo but not of it.
#
# `.claude/worktrees/` is where feature branches are checked out (CLAUDE.md,
# "Worktrees"), so an open worktree made `git status` permanently dirty on main
# — which `tools/preflight_release.py` correctly reported as "not ready to
# archive". The check is right; these are simply not the repo's files.
#
# Deliberately not ignoring `.claude/` wholesale: a shared `settings.json` or
# agent definition would be worth tracking, and only the personal and generated
# parts are listed here.
.claude/worktrees/
.claude/plans/
.claude/settings.local.json

# Build products
build/
*.ipa
*.dSYM
*.dSYM.zip

# SwiftPM
.build/
Packages/
Package.resolved

# CocoaPods (if you use it)
Pods/

# Carthage (if used)
Carthage/Build/

# Fastlane (if used)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# Claude Code local settings
.claude/settings.local.json

# Wrangler (Cloudflare CLI) local cache — created by ad-hoc npx runs
.wrangler/

# Python
__pycache__/

# Eval review pages are rebuilt from the run (tools/eval/build_review.py)
docs/eval/runs/*/review.html

# Tile image sets
# Masters (playful_3d, high_contrast) are tracked via Git LFS — see .gitattributes
# and the "Working on tile image sets" section of docs/collaborator-workflow.md.
# Optimized + current_* directories are regenerable intermediates from the masters.
tools/tile_sets/optimized/
tools/tile_sets/current/
tools/tile_sets/current_p3d/
tools/tile_sets/current_arasaac/
tools/tile_sets/current_classic/
# fetch_reference_art.py: ARASAAC pictograms for review only. CC BY-NC-SA, never shipped.
tools/reference_art/
# build_review_page.py's copies of the shipped bundle, one per set prefix
tools/tile_sets/current_*/

# Review tool artifacts (regenerable)
tools/tile_sets/playful_3d/review/
tools/tile_sets/high_contrast/review/
tools/tile_sets/playful_3d_v2/review/
tools/tile_sets/review_*.html
tools/tile_sets/*_failed.txt
tools/tile_sets/assets_link
# analyze_set.py reports — per-round working files. The numbers that matter
# are quoted in docs/imageset-highcontrast-log.md.
tools/tile_sets/analysis/

# Downloaded symbol sets (large — re-download with tools scripts)
tools/sclera/

# Secrets / API keys
.env
*.secret
Config.swift
Secrets.swift

# Generated review surfaces (session 2B) — rebuilt by their tools on demand.
tools/tile_sets/encoding_review/
tools/tile_sets/tone_review/
tools/tile_sets/tone_inversions/
tools/tile_sets/tone_chain_review/
# The unshipped 4th tone: kept on disk as the floor the shipped tones stay
# lighter than, untracked because 259 PNGs would want LFS.
tools/tile_sets/classic_chain_dark/
tools/tile_sets/cutsheet/
tools/tile_sets/tone_cutsheet/
# Exemplar / new-word experiments: evidence that runtime tone-matching works,
# regenerable from tools/test_tone_exemplar.py.
tools/tile_sets/exemplar_*/
tools/tile_sets/new_words/
tools/tile_sets/*_gi2/
tools/tile_sets/review_*_gi2.html
tools/tile_sets/review_*_gi2__*.html
tools/tile_sets/packcovers/*_gi2_*.png
